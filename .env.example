APP_ENV=development
APP_BASE_URL=http://localhost:8000
CLIENT_BASE_URL=http://localhost:5173

# Database configuration (PostgreSQL via psycopg or SQLite fallback)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/carti_db

# LLM provider settings
LLM_PROVIDER=gemini
LLM_API_KEY=replace_me
LLM_MODEL=gemini-2.5-flash

# Channel3 configuration
CHANNEL3_API_KEY=replace_me
CHANNEL3_BASE_URL=https://api.trychannel3.com/v1
CHANNEL3_COUNTRY=US
CHANNEL3_LANGUAGE=en
CHANNEL3_CURRENCY=USD

# PayPal Sandbox settings
PAYPAL_ENV=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=replace_me
PAYPAL_CLIENT_SECRET=replace_me
PAYPAL_WEBHOOK_ID=replace_me

# KERNEL Browser Verification (optional)
KERNEL_ENABLED=false
KERNEL_API_KEY=replace_me

# Security & Sessions
SESSION_SECRET=replace_with_random_secret_32_chars_long
SESSION_COOKIE_NAME=carti_session
SESSION_EXPIRE_DAYS=7
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
DEMO_USER_ENABLED=true
DEMO_USER_EMAIL=demo-user@carti.local

# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_CREATE_REQUESTS_PER_MINUTE=10

LOG_LEVEL=INFO
